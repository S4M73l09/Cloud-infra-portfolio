<div class="ascii-city" aria-hidden="true">
  <canvas class="ascii-canvas"></canvas>
</div>

<script>
    const canvas = document.querySelector('.ascii-canvas');

    if (canvas instanceof HTMLCanvasElement) {
      const context = canvas.getContext('2d');
      const nodes = [];
      const coreConnections = [];
      const networkCellWidth = 135;
      const networkCellHeight = 110;
      const networkColumns = 8;
      const networkRows = 6;
      const networkTileWidth = networkColumns * networkCellWidth;
      const networkTileHeight = networkRows * networkCellHeight;
      const devopsPhrases = [
        'terraform init',
        'terraform plan -out=infra.tfplan',
        'ansible-playbook site.yml',
        'kubectl get pods --all-namespaces',
        'prometheus query --target=infra',
        'deploy reproducible infrastructure',
        'observe every service',
        'secure by default',
        'trivy image --severity HIGH,CRITICAL',
        'checkov -d infrastructure/',
        'opa eval --data policy.rego',
        'conftest test terraform/',
        'scan before deploy',
        'policy as code: enforced'
      ];
      const phraseParticles = [];
      let width = 0;
      let height = 0;
      let start = performance.now();
      let scheduleIndex = 0;
      let glitchSchedule;
      let animationStarted = !document.body.classList.contains('await-profile-entry');
      let isMobileViewport = window.innerWidth <= 720;
      let lowQualityMode = document.body.classList.contains('background-blur') || isMobileViewport;
      let lastLowQualityFrame = 0;
      let previousCorruption = false;

      const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

      const random = (seed) => {
        const value = Math.sin(seed * 12.9898) * 43758.5453;
        return value - Math.floor(value);
      };

      function createGlitchSchedule(windowStart) {
        const seed = scheduleIndex * 101 + 17;
        const windowDuration = 5 + random(seed) * 10;
        const pulseCount = Math.floor(random(seed + 1) * 4);
        const pulses = [];

        for (let index = 0; index < pulseCount; index += 1) {
          const pulseSeed = seed + index * 23;
          const pulseStart = windowStart + 0.7 + random(pulseSeed + 2) * Math.max(1, windowDuration - 1.4);
          const pulseDuration = 0.55 + random(pulseSeed + 3) * 0.5;
          pulses.push({
            start: pulseStart,
            end: Math.min(windowStart + windowDuration, pulseStart + pulseDuration)
          });
        }

        return {
          end: windowStart + windowDuration,
          restEnd: windowStart + windowDuration + 5,
          pulses
        };
      }

      glitchSchedule = createGlitchSchedule(0);

      function resize() {
        width = window.innerWidth;
        height = window.innerHeight;
        isMobileViewport = window.innerWidth <= 720;
        const renderScale = document.body.classList.contains('background-blur')
          ? isMobileViewport ? 0.52 : 0.68
          : isMobileViewport ? 0.72 : 1;
        lowQualityMode = document.body.classList.contains('background-blur') || isMobileViewport;
        canvas.width = Math.floor(width * renderScale);
        canvas.height = Math.floor(height * renderScale);
        context.setTransform(renderScale, 0, 0, renderScale, 0, 0);
        nodes.length = 0;
        coreConnections.length = 0;
        phraseParticles.length = 0;

        // Build one deterministic tile; copies of this tile can loop forever.
        for (let row = 0; row <= networkRows; row += 1) {
          for (let column = 0; column <= networkColumns; column += 1) {
            const edgeX = column === 0 || column === networkColumns;
            const edgeY = row === 0 || row === networkRows;
            nodes.push({
              x: column * networkCellWidth + (edgeX ? 0 : (random(row * 17 + column * 31) - 0.5) * 70),
              y: row * networkCellHeight + (edgeY ? 0 : (random(row * 29 + column * 11) - 0.5) * 58),
              radius: random(row * 41 + column * 7) > 0.82 ? 3 : 1
            });
          }
        }

        devopsPhrases.slice(0, 3).forEach((phrase, index) => {
          phraseParticles.push({
            phrase,
            x: random(index * 53 + 9) * width,
            y: random(index * 71 + 17) * height,
            velocityX: (random(index * 89 + 23) - 0.5) * 18,
            velocityY: (random(index * 97 + 31) - 0.5) * 8,
            phase: random(index * 113 + 41) * Math.PI * 2
          });
        });

        for (let index = 0; index < 14; index += 1) {
          coreConnections.push({
            angle: random(index * 131 + 7) * Math.PI * 2,
            length: Math.min(width, height) * (0.18 + random(index * 137 + 11) * 0.48),
            widthRatio: 0.72 + random(index * 149 + 19) * 0.65,
            speed: 0.12 + random(index * 157 + 23) * 0.2,
            phase: random(index * 163 + 29)
          });
        }

      }

      function pixelLine(from, to, color, alpha, width = 1, offsetX = 0, offsetY = 0) {
        context.globalAlpha = alpha;
        context.strokeStyle = color;
        context.lineWidth = width;
        context.beginPath();
        context.moveTo(Math.round(from.x + offsetX), Math.round(from.y + offsetY));
        context.lineTo(Math.round(to.x + offsetX), Math.round(to.y + offsetY));
        context.stroke();
      }

      function draw(timestamp) {
        if (!animationStarted) {
          return;
        }
        if (lowQualityMode && timestamp - lastLowQualityFrame < 1000 / 48) {
          requestAnimationFrame(draw);
          return;
        }
        lastLowQualityFrame = timestamp;
        const elapsed = (timestamp - start) / 1000;
        const lowQuality = lowQualityMode;
        if (elapsed >= glitchSchedule.restEnd) {
          scheduleIndex += 1;
          glitchSchedule = createGlitchSchedule(glitchSchedule.restEnd);
        }
        const activePulse = glitchSchedule.pulses.find(
          (pulse) => elapsed >= pulse.start && elapsed < pulse.end
        );
        const fullCorruption = Boolean(activePulse);
        const corruptionProgress = activePulse
          ? clamp((elapsed - activePulse.start) / (activePulse.end - activePulse.start), 0, 1)
          : 0;
        if (fullCorruption !== previousCorruption) {
          document.body.classList.toggle('glitch-active', fullCorruption);
          previousCorruption = fullCorruption;
        }
        const globalShake = fullCorruption ? (1 - corruptionProgress) * 5 : 0;
        const globalShakeX = globalShake ? (random(Math.floor(timestamp / 19)) - 0.5) * globalShake : 0;
        const globalShakeY = globalShake ? (random(Math.floor(timestamp / 23) + 13) - 0.5) * globalShake : 0;
        context.save();
        context.translate(globalShakeX, globalShakeY);
        context.clearRect(0, 0, width, height);
        context.fillStyle = '#010203';
        context.fillRect(0, 0, width, height);

        const signalJitter = fullCorruption ? (1 - corruptionProgress) * 9 : 0;
        const traceOffset = (seed, speed = 1) =>
          Math.sin(elapsed * speed + seed * 0.7) * 4 +
          (random(Math.floor(elapsed * 18) + seed) - 0.5) * signalJitter;
        const glitchColor = fullCorruption ? '#ff4655' : '#83b9ff';
        const networkColor = fullCorruption ? '#ff6b73' : '#e6eee9';
        const nodeColor = fullCorruption ? '#ff4655' : '#f2f6f3';
        // Tile the network beyond the viewport so directional scrolling can loop seamlessly.
        const networkOffsetX = -((elapsed * 12) % networkTileWidth) + traceOffset(241, 0.22);
        const networkOffsetY = -((elapsed * 5) % networkTileHeight) + traceOffset(257, 0.18);

        const drawNetwork = (tileX, tileY, clip) => {
          context.save();
          if (clip) {
            context.beginPath();
            context.rect(clip.x, clip.y, clip.width, clip.height);
            context.clip();
          }
          context.translate(networkOffsetX + tileX, networkOffsetY + tileY);
          nodes.forEach((node, index) => {
            if (lowQuality && index % 2 !== 0) return;
            const next = nodes[index + 1];
            const below = nodes[index + networkColumns + 1];
            const offsetX = traceOffset(index, 1.35);
            const offsetY = traceOffset(index + 31, 1.1);
            if (next && Math.abs(next.y - node.y) < 90) {
              pixelLine(node, next, networkColor, 0.16, 1, offsetX, offsetY);
            }
            if (below && Math.abs(below.x - node.x) < 100) {
              pixelLine(node, below, networkColor, 0.12, 1, offsetX, offsetY);
            }
          });

          context.fillStyle = nodeColor;
          nodes.forEach((node, index) => {
            if (lowQuality && index % 2 !== 0) return;
            const pulse = 0.28 + (Math.sin(elapsed * 2 + index) + 1) * 0.16;
            context.globalAlpha = pulse;
            context.fillRect(Math.round(node.x), Math.round(node.y), node.radius, node.radius);
          });
          context.restore();
        };

        const tilePaddingX = lowQuality ? 0 : networkTileWidth;
        const tilePaddingY = lowQuality ? 0 : networkTileHeight;
        for (let tileX = -networkTileWidth; tileX <= width + tilePaddingX; tileX += networkTileWidth) {
          for (let tileY = -networkTileHeight; tileY <= height + tilePaddingY; tileY += networkTileHeight) {
            drawNetwork(tileX, tileY, null);
          }
        }

        const coreX = width * 0.78 + traceOffset(151, 0.52) * 1.4;
        const coreY = height * 0.31 + traceOffset(167, 0.64) * 1.4;
        const radialDriftX = Math.sin(elapsed * 0.28) * 26 + traceOffset(271, 0.2);
        const radialDriftY = Math.sin(elapsed * 0.22 + 1.2) * 18 + traceOffset(283, 0.17);
        context.globalAlpha = fullCorruption ? 0.22 : 0.1;
        coreConnections.forEach((connection, index) => {
          if (lowQuality && index % 2 !== 0) return;
          const connectionCycle = (elapsed * connection.speed + connection.phase) % 1;
          const connectionFade = Math.sin(Math.PI * connectionCycle);
          const angle = connection.angle + Math.sin(elapsed * 0.16 + connection.phase * 8) * 0.24;
          const distance = connection.length + Math.sin(elapsed * 0.22 + index) * 18;
          const corruptionShiftX = fullCorruption
            ? (random(Math.floor(elapsed * 34) + index) - 0.5) * signalJitter * 2
            : 0;
          const corruptionShiftY = fullCorruption
            ? (random(Math.floor(elapsed * 37) + index + 71) - 0.5) * signalJitter * 2
            : 0;
          const target = {
            x: coreX + Math.cos(angle) * distance * connection.widthRatio + radialDriftX + corruptionShiftX,
            y: coreY + Math.sin(angle) * distance + radialDriftY + corruptionShiftY
          };
          pixelLine({ x: coreX, y: coreY }, target, glitchColor, 0.1 * connectionFade, 1, 0, 0);
        });

        // Angular surveillance geometry and fragmented signal blocks.
        context.globalAlpha = 0.22;
        context.strokeStyle = fullCorruption ? '#ff4655' : '#f2f6f3';
        const leftDrift = traceOffset(71, 1.05);
        const rightDrift = traceOffset(93, 1.2);
        context.beginPath();
        context.moveTo(width * 0.04 + leftDrift, height * 0.19);
        context.lineTo(width * 0.18 + leftDrift, height * 0.19 + leftDrift * 0.3);
        context.lineTo(width * 0.25 + leftDrift, height * 0.29);
        context.lineTo(width * 0.25 + leftDrift, height * 0.54);
        context.lineTo(width * 0.34 + leftDrift, height * 0.63 + leftDrift * 0.2);
        context.stroke();
        context.beginPath();
        context.moveTo(width * 0.88 + rightDrift, height * 0.12);
        context.lineTo(width * 0.77 + rightDrift, height * 0.12 + rightDrift * 0.2);
        context.lineTo(width * 0.7 + rightDrift, height * 0.23);
        context.lineTo(width * 0.7 + rightDrift, height * 0.46);
        context.stroke();

        for (let index = 0; index < 7; index += 1) {
          const y = height * (0.22 + index * 0.075) + traceOffset(index + 110, 1.2);
          const startX = width * (0.56 + (index % 2) * 0.08) + traceOffset(index + 120, 1.05);
          const length = width * (0.08 + random(index + Math.floor(elapsed * 2)) * 0.2);
          context.globalAlpha = 0.16 + (index % 3) * 0.05;
          context.fillStyle = index === 3 ? glitchColor : nodeColor;
          context.fillRect(startX, y, length, 2);
          if (index % 2 === 0) context.fillRect(startX + length + 10, y, 4, 2);
        }

        context.globalAlpha = fullCorruption ? 0.3 : 0.15;
        context.strokeStyle = glitchColor;
        const nodeHudCenterX = coreX;
        const nodeHudCenterY = coreY;
        context.beginPath();
        context.arc(nodeHudCenterX, nodeHudCenterY, 38, 0, Math.PI * 2);
        context.moveTo(nodeHudCenterX - 52, nodeHudCenterY);
        context.lineTo(nodeHudCenterX + 52, nodeHudCenterY);
        context.moveTo(nodeHudCenterX, nodeHudCenterY - 52);
        context.lineTo(nodeHudCenterX, nodeHudCenterY + 52);
        context.shadowColor = glitchColor;
        context.shadowBlur = fullCorruption ? 16 : 9;
        context.stroke();

        context.globalAlpha = fullCorruption ? 0.7 : 0.34;
        context.fillStyle = glitchColor;
        context.shadowBlur = fullCorruption ? 12 : 6;
        context.fillRect(nodeHudCenterX - 2, nodeHudCenterY - 2, 4, 4);
        context.shadowBlur = 0;

        context.globalAlpha = 0.42;
        context.fillStyle = '#f2f6f3';
        context.font = '11px "IBM Plex Mono", monospace';
        context.fillText('NODE // 07', nodeHudCenterX + 2, nodeHudCenterY - 62);
        context.fillText('SIGNAL: ACTIVE', nodeHudCenterX + 2, nodeHudCenterY + 68);

        // DevOps phrases travel independently through the scene like signal particles.
        context.font = '11px "IBM Plex Mono", monospace';
        context.save();
        context.filter = fullCorruption ? 'invert(1)' : 'none';
        const phraseEpoch = Math.floor(elapsed / 6);
        const phraseProgress = (elapsed % 6) / 6;
        const phraseFade = clamp(Math.min(phraseProgress / 0.2, (1 - phraseProgress) / 0.2), 0, 1);
        const activePhraseCount = 1 + Math.floor(random(phraseEpoch + 811) * 3);
        phraseParticles.forEach((particle, index) => {
          if (index >= activePhraseCount) return;
          const phraseIndex = Math.floor(random(phraseEpoch * 37 + index * 19 + 503) * devopsPhrases.length);
          const phrase = devopsPhrases[phraseIndex];
          const phraseX = ((particle.x + elapsed * particle.velocityX) % (width + 360) + width + 360) % (width + 360) - 180;
          const phraseY = ((particle.y + elapsed * particle.velocityY) % (height + 120) + height + 120) % (height + 120) - 60;
          const driftX = Math.sin(elapsed * 0.34 + particle.phase) * 12;
          const driftY = Math.cos(elapsed * 0.27 + particle.phase) * 7;
          const corruptionShift = fullCorruption
            ? (random(Math.floor(elapsed * 34) + index) - 0.5) * 30
            : 0;
          const baseAlpha = fullCorruption ? 0.78 : 0.24 + (index % 3) * 0.05;
          context.globalAlpha = baseAlpha * phraseFade;
          context.fillStyle = fullCorruption ? '#ff4655' : index % 3 === 0 ? '#83b9ff' : '#f2f6f3';
          context.fillText(`> ${phrase}`, phraseX + driftX + corruptionShift, phraseY + driftY);
          if (fullCorruption && index % 2 === 0) {
            context.globalAlpha = 0.32 * phraseFade;
            context.fillText(`> ${phrase}`, phraseX + driftX - 8, phraseY + driftY + 3);
          }
        });
        context.restore();
        
        // Sparse white corruption artifacts: broken rows, shifted fragments and file-like noise.
        const corruptionSeed = Math.floor(elapsed * 7);
        for (let index = 0; index < (lowQuality ? 2 : 5); index += 1) {
          const seed = corruptionSeed * 47 + index * 19;
          const y = Math.floor(random(seed) * height);
          const x = Math.floor(random(seed + 1) * width);
          const fragmentWidth = Math.max(3, Math.floor(random(seed + 2) * width * 0.16));
          const fragmentHeight = random(seed + 3) > 0.78 ? 3 : 1;
          const bright = random(seed + 4) > 0.76;
          context.globalAlpha = bright ? 0.62 : 0.2;
          context.fillStyle = '#ffffff';
          context.fillRect(x, y, fragmentWidth, fragmentHeight);
          if (random(seed + 5) > 0.66) {
            context.globalAlpha *= 0.62;
            context.fillRect(x + fragmentWidth * 0.35, y + fragmentHeight + 2, fragmentWidth * 0.22, 1);
          }
        }

        if (corruptionSeed % 9 === 0) {
          context.globalAlpha = 0.48;
          context.fillStyle = '#ffffff';
          const tearY = Math.floor(random(corruptionSeed + 91) * height);
          context.fillRect(width * 0.08, tearY, width * 0.34, 2);
          context.fillRect(width * 0.56, tearY + 3, width * 0.18, 1);
          context.globalAlpha = 0.12;
          context.fillStyle = '#010203';
          context.fillRect(width * 0.23, tearY - 2, width * 0.4, 6);
        }

        // A rare full-frame corruption event, followed by a clean recovery.
        if (fullCorruption) {
          const frameSeed = Math.floor(elapsed * 28);
          const recovery = corruptionProgress;
          const regionWidth = width * (0.22 + random(frameSeed + 3) * 0.2);
          const regionHeight = height * (0.16 + random(frameSeed + 4) * 0.18);
          const regionX = random(frameSeed + 5) > 0.5 ? width * 0.06 : width * 0.66;
          const regionY = height * (0.2 + random(frameSeed + 6) * 0.52);
          const shake = (1 - recovery) * 9;
          const shakeX = (random(frameSeed + 7) - 0.5) * shake;
          const shakeY = (random(frameSeed + 8) - 0.5) * shake;

          // The whole signal breaks into displaced horizontal slices first.
          context.globalCompositeOperation = 'screen';
          for (let slice = 0; slice < 12; slice += 1) {
            const sliceSeed = frameSeed * 31 + slice * 17;
            const sliceY = Math.floor(random(sliceSeed) * height);
            const sliceHeight = random(sliceSeed + 1) > 0.76 ? 3 : 1;
            const sliceX = (random(sliceSeed + 2) - 0.5) * width * 0.08;
            context.globalAlpha = (0.08 + random(sliceSeed + 3) * 0.2) * (1 - recovery * 0.6);
            context.fillStyle = slice % 4 === 0 ? '#83b9ff' : '#ffffff';
            context.fillRect(sliceX, sliceY, width * (0.35 + random(sliceSeed + 4) * 0.65), sliceHeight);
          }

          // Pixel blocks spread through the background at the moment of impact.
          const pixelation = 1 - recovery;
          const blockSize = Math.max(5, Math.round(Math.min(width, height) * 0.009));
          context.globalCompositeOperation = 'screen';
          for (let block = 0; block < (lowQuality ? 34 : 72); block += 1) {
            const blockSeed = frameSeed * 47 + block * 29;
            const blockX = Math.floor(random(blockSeed) * (width / blockSize)) * blockSize;
            const blockY = Math.floor(random(blockSeed + 1) * (height / blockSize)) * blockSize;
            const blockWidth = blockSize * (1 + Math.floor(random(blockSeed + 2) * 5));
            const blockHeight = blockSize * (1 + Math.floor(random(blockSeed + 3) * 3));
            const blockAlpha = (0.08 + random(blockSeed + 4) * 0.3) * pixelation;
            context.globalAlpha = blockAlpha;
            context.fillStyle = block % 5 === 0 ? '#83b9ff' : '#ffffff';
            context.fillRect(blockX, blockY, blockWidth, blockHeight);
            if (block % 3 === 0) {
              context.globalAlpha = blockAlpha * 0.8;
              context.fillStyle = '#010203';
              context.fillRect(blockX + blockSize, blockY, blockWidth * 0.6, blockHeight);
            }
          }

          context.globalAlpha = 0.24 * pixelation;
          context.fillStyle = '#010203';
          for (let band = 0; band < 8; band += 1) {
            const bandSeed = frameSeed * 73 + band * 11;
            const bandY = Math.floor(random(bandSeed) * height);
            const bandHeight = blockSize * (1 + Math.floor(random(bandSeed + 1) * 2));
            const bandX = (random(bandSeed + 2) - 0.5) * width * 0.12;
            context.fillRect(bandX, bandY, width * (0.18 + random(bandSeed + 3) * 0.55), bandHeight);
          }
          context.globalCompositeOperation = 'source-over';

          context.save();
          context.beginPath();
          context.rect(regionX, regionY, regionWidth, regionHeight);
          context.clip();
          context.translate(shakeX, shakeY);
          context.globalCompositeOperation = recovery > 0.72 ? 'source-over' : 'screen';
          context.globalAlpha = 0.32 * (1 - recovery);
          context.fillStyle = '#ffffff';
          context.fillRect(regionX, regionY, regionWidth, regionHeight);

          for (let index = 0; index < 30; index += 1) {
            const seed = frameSeed * 61 + index * 23;
            const y = regionY + Math.floor(random(seed) * regionHeight);
            const x = regionX + Math.floor(random(seed + 1) * regionWidth);
            const fragmentWidth = Math.max(8, random(seed + 2) * regionWidth * 0.9);
            const fragmentHeight = random(seed + 3) > 0.82 ? 4 : 1;
            context.globalAlpha = (0.12 + random(seed + 4) * 0.56) * (1 - recovery * 0.55);
            context.fillStyle = index % 7 === 0 ? '#83b9ff' : '#ffffff';
            context.fillRect(x, y, fragmentWidth, fragmentHeight);
          }

          context.globalAlpha = 0.8 * (1 - recovery);
          context.strokeStyle = '#ffffff';
          context.lineWidth = 2;
          context.strokeRect(regionX, regionY, regionWidth, regionHeight);
          context.globalCompositeOperation = 'source-over';
          context.restore();
          context.globalCompositeOperation = 'source-over';
        }

        context.globalAlpha = 0.36;
        context.strokeStyle = '#f2f6f3';
        context.lineWidth = 1;
        context.beginPath();
        context.moveTo(width * 0.12, height * 0.82);
        context.lineTo(width * 0.31, height * 0.82);
        context.lineTo(width * 0.39, height * 0.69);
        context.lineTo(width * 0.62, height * 0.69);
        context.lineTo(width * 0.78, height * 0.48);
        context.stroke();

        context.globalAlpha = 0.5;
        context.fillStyle = '#f2f6f3';
        context.fillRect(width * 0.31, height * 0.81, 5, 5);
        context.fillRect(width * 0.62, height * 0.68, 4, 4);
        context.fillRect(width * 0.78, height * 0.47, 6, 6);

        const glitchY = Math.floor((elapsed * 17) % 9) * 9;
        context.globalAlpha = 0.18;
        context.fillRect(0, glitchY, width * (0.12 + random(Math.floor(elapsed * 4)) * 0.28), 1);
        context.globalAlpha = 1;
        context.restore();
        requestAnimationFrame(draw);
      }

      window.addEventListener('resize', resize);
      document.addEventListener('portfolio:intro-complete', () => {
        if (animationStarted) return;
        animationStarted = true;
        start = performance.now();
        glitchSchedule = createGlitchSchedule(0);
        resize();
        requestAnimationFrame(draw);
      });
      resize();
      if (animationStarted) requestAnimationFrame(draw);
    }
</script>
